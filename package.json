{
  "name": "internship-api",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for internship records: Node.js, Express, SQLite, validation and pagination.",
  "main": "src/server.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server.js",
    "seed": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/seed.js",
    "db:reset": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/seed.js --reset",
    "test": "node --test"
  },
  "engines": { "node": ">=22.13.0" },
  "dependencies": { "express": "^5.1.0" }
}
